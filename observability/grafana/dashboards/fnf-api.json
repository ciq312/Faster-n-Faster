{
  "uid": "fnf-api-local",
  "title": "Faster-n-Faster API",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests",
      "description": "Requests per second averaged over two minutes. Readiness probes are excluded.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "interval": "10s",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"faster-n-faster-api\",http_route!=\"/api/health\"}[2m]))",
          "legendFormat": "Requests",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx",
      "description": "Percentage of requests returning 5xx over two minutes. Readiness probes are excluded.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "interval": "10s",
          "expr": "100 * (sum(rate(http_server_request_duration_seconds_count{job=\"faster-n-faster-api\",http_route!=\"/api/health\",http_response_status_code=~\"5..\"}[2m])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"faster-n-faster-api\",http_route!=\"/api/health\"}[2m])), 0.000001)",
          "legendFormat": "5xx",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP latency p95",
      "description": "95th-percentile request duration over two minutes. Readiness probes and long-lived SignalR transports are excluded.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
