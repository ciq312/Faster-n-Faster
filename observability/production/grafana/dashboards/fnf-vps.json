          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "interval": "30s",
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Used · {{instance}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "interval": "30s",
          "expr": "redis_memory_max_bytes > 0",
          "legendFormat": "Limit · {{instance}}",
          "range": true
