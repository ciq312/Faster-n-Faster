{
  "description": "Repository branch and documentation guards. Review and trust through /hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|shell_command|apply_patch|Edit|Write|Agent|spawn_agent|EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/dispatch.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
