              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/google/callback": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Finish Google sign-in",
        "description": "Called by Google, not by the client. Logs the player in, sets the auth cookies and redirects to the same-origin `returnUrl`; on failure it redirects with an `error` query parameter.",
        "operationId": "FasterNFasterApiPresentationWebAuthGoogleAuthGoogleCallbackEndpoint",
        "responses": {
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "302": {
            "description": "Redirect back to the frontend"
          }
        }
      }
    },
    "/api/auth/google": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Start Google sign-in",
        "description": "Redirects the browser to Google's consent screen. Google returns to `/api/auth/google/callback`, which forwards to `returnUrl`.",
        "operationId": "FasterNFasterApiPresentationWebAuthGoogleAuthGoogleChallengeEndpoint",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to Google"
          }
        }
      }
    }
  },
