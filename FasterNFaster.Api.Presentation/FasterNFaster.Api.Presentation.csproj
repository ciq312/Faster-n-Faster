<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="FastEndpoints" Version="8.0.1" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="NSwag.AspNetCore" Version="14.7.1" />
    <PackageReference Include="NSwag.MSBuild" Version="14.7.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FasterNFaster.Api.Domain\FasterNFaster.Api.Domain.csproj" />
    <ProjectReference Include="..\FasterNFaster.Api.Infrastructure\FasterNFaster.Api.Infrastructure.csproj" />
    <ProjectReference Include="..\FasterNFaster.Api.UseCases\FasterNFaster.Api.UseCases.csproj" />
  </ItemGroup>

  <!-- Debug builds regenerate the client contracts; pass GenerateContracts=false to skip it where nothing reads them. -->
  <PropertyGroup>
    <GenerateContracts Condition="'$(GenerateContracts)' == '' And '$(Configuration)' == 'Debug'">true</GenerateContracts>
  </PropertyGroup>

  <Target Name="NSwag" AfterTargets="Build" Condition="'$(GenerateContracts)' == 'true'">
    <Copy SourceFiles="@(Reference)" DestinationFolder="$(OutDir)References" />
    <!-- NSwag converts DateTimeOffset examples to the machine's time zone; UTC keeps swagger.json identical on every machine and in CI. -->
    <Exec Command="$(NSwagExe_Net100) run nswag.json" EnvironmentVariables="TZ=UTC" />
    <RemoveDir Directories="$(OutDir)References" />
  </Target>

  <Target Name="TypedSignalR" AfterTargets="Build" Condition="'$(GenerateContracts)' == 'true'">
    <RemoveDir Directories="../fasternfasterapp/generated/signalr" />
    <Exec Command="dotnet tool run dotnet-tsrts --project $(MSBuildProjectFullPath) --output ../fasternfasterapp/generated/signalr --asm" />
  </Target>

</Project>
