{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "Issuer": "IssuerServer",
    "Audience": "AudienceServer",
    "AccessTokenLifetime": "00:05:00",
    "GuestAccessTokenLifetime": "7.00:00:00",
    "RefreshTokenLifetime": "04:00:00"
  },
  "AuthCookies": {
      "AccessTokenCookieName": "access_token",
      "RefreshTokenCookieName": "refresh_token",
      "CookieSameSite": "Lax",
      "Secure": true,
      "HttpOnly": true,
      "RefreshTokenPath": "/api/auth/refresh"
    },
     "Smtp": {
      "Host": "smtp.resend.com",
      "Port": 587,
      "FromAddress": "noreply@faster-n-faster.com",
      "UseStartTls": true
    },
    "AppUrls" : {
      "FrontendUrl": "https://faster-n-faster.com",
      "BackendUrl": "https://faster-n-faster.com"
    },
    "Cors": {
      "AllowedOrigins": [
        "https://faster-n-faster.com",
        "https://www.faster-n-faster.com"
      ]
    },
    "RateLimiting": {
      "Enabled": true,
      "Global": { "PermitLimit": 300, "Window": "00:01:00" },
      "AuthStrict": { "PermitLimit": 5, "Window": "00:01:00" },
      "AuthModerate": { "PermitLimit": 10, "Window": "00:01:00" },
      "Lookup": { "PermitLimit": 30, "Window": "00:01:00" }
    },
    "AntiCheat": {
      "SustainedMaxWpm": 300,
      "BurstMaxWpm": 600,
      "AverageWordLength": 5,
      "BurstMinIndexDelta": 15,
      "SustainedCheckMinIndex": 30
    },
    "ConfirmTokens": {
      "EmailVerification": {
        "ExpirationTime": "1:00:00",
        "Cooldown": "00:00:15"
      },
      "PasswordReset": {
        "ExpirationTime": "00:15:00",
        "Cooldown": "00:00:15"
      }
    }
  }
